+def _build_fast_preprocess(device, resolution):
+    try:
+        from torchvision.io import ImageReadMode, decode_jpeg
+        from torchvision.transforms import InterpolationMode
+        from torchvision.transforms.v2 import functional as TF
+    except Exception:
+        return None
+
+    mean = torch.tensor(_MEAN, device=device).view(1, 3, 1, 1)
+    std = torch.tensor(_STD, device=device).view(1, 3, 1, 1)
+
+    def prep_one(record):
+        data = record.get("bytes") if isinstance(record, dict) else None
+        if data is None and isinstance(record, dict) and record.get("path"):
+            with open(record["path"], "rb") as fh:
+                data = fh.read()
+        x = decode_jpeg(torch.frombuffer(bytearray(data), dtype=torch.uint8),
+                        mode=ImageReadMode.RGB)
+        x = TF.resize(x, resolution, interpolation=InterpolationMode.BICUBIC, antialias=True)
+        return TF.center_crop(x, [resolution, resolution])
+
+    def finish_batch(tensors):
+        batch = torch.stack(tensors).to(device, non_blocking=True)
+        return batch.float().div_(255.0).sub_(mean).div_(std)
+
+    return prep_one, finish_batch
+
 
